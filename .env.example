# Modelo do .env usado pelo docker compose (copie para .env na raiz e preencha).
# O .env esta no .gitignore: nunca commite valores reais.

# Banco (container Postgres do compose)
POSTGRES_DB=hemotrack
POSTGRES_USER=hemotrack
POSTGRES_PASSWORD=<troque-por-uma-senha>

# JWT: string aleatoria com no minimo 32 caracteres (ex.: openssl rand -base64 48)
JWT_SECRET=<string-aleatoria-com-no-minimo-32-caracteres>

# Admin do sistema (opcional): cria o usuario que aprova instituicoes
ADMIN_EMAIL=admin@hemotrack.local
ADMIN_SENHA=<uma-senha-boa>
