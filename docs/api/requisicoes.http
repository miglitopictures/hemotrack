###############################################################################
# HemoTrack — API de Requisições de Transfusão
#
# Como rodar:
#   VS Code  -> instalar a extensão "REST Client" (humao.rest-client)
#               e clicar em "Send Request" acima de cada bloco ###
#   IntelliJ -> formato nativo, é só abrir e clicar no ▶
#
# Pré-requisito: backend no ar (cd backend && ./mvnw spring-boot:run)
#
# Rode os blocos NA ORDEM na primeira vez: os blocos 3 em diante reutilizam
# o id devolvido pelo bloco 1, via {{criar.response.body.$.id}}.
#
# REGRA DO FORMATO: dentro de um bloco, o corpo JSON é a ÚLTIMA coisa.
# Tudo que vier depois de uma linha em branco pós-headers é tratado como
# corpo da requisição, inclusive linhas @variavel. Por isso todo comentário
# fica ACIMA da linha do método.
###############################################################################

@baseUrl = http://localhost:8080
@contentType = application/json


###############################################################################
# CAMINHO FELIZ
###############################################################################

### 1. Criar requisição (status inicial: ABERTA)
# Esperado: 200 + objeto com "status": "ABERTA" e "dataCriacao" preenchida.
# ATENÇÃO: é 200, não 201, e não vem header Location.
# Os enums vão como STRING. Mandar número (ex.: "tipo": 0) até funciona —
# o Jackson aceita o ordinal — mas amarra o JSON à ordem de declaração do
# enum (os enums são persistidos como ORDINAL). Não use.
# @name criar
POST {{baseUrl}}/requisicoes
Content-Type: {{contentType}}

{
  "hospitalId": 7,
  "tipo": "HEMACIAS",
  "abo": "O",
  "rh": "NEGATIVO",
  "volumeMl": 450,
  "prioridade": "EMERGENCIA",
  "observacoes": "Paciente politraumatizado, sala vermelha"
}

### 2. Listar todas as requisições
# Esperado: 200 + array (vazio se o banco estiver limpo).
GET {{baseUrl}}/requisicoes
Accept: {{contentType}}

### 3. Buscar a requisição criada
# Esperado: 200 + o mesmo objeto do bloco 1.
GET {{baseUrl}}/requisicoes/{{criar.response.body.$.id}}
Accept: {{contentType}}

### 4. Atualizar prioridade
# Esperado: 200 + objeto com "prioridade": "NORMAL".
# ATENÇÃO: o service só copia `prioridade`. Qualquer outro campo mandado
# aqui é silenciosamente ignorado — na prática isso é um PATCH de 1 campo.
PUT {{baseUrl}}/requisicoes/{{criar.response.body.$.id}}
Content-Type: {{contentType}}

{
  "hospitalId": 7,
  "tipo": "HEMACIAS",
  "abo": "O",
  "rh": "NEGATIVO",
  "volumeMl": 450,
  "prioridade": "NORMAL",
  "observacoes": "Paciente politraumatizado, sala vermelha"
}

### 5. Aceitar  (ABERTA -> ACEITA)
# Esperado: 200 + objeto com "status": "ACEITA".
POST {{baseUrl}}/requisicoes/{{criar.response.body.$.id}}/aceitar


###############################################################################
# CAMINHOS DE ERRO
###############################################################################

### 6. Aceitar de novo -> 409 Conflict
# Esperado: 409
# { "status": 409, "detail": "Requisição não está aberta", ... }
# Só saímos de ABERTA. Essa é a guarda de concorrência do service.
POST {{baseUrl}}/requisicoes/{{criar.response.body.$.id}}/aceitar

### 7. Recusar algo que não está ABERTA -> 409 Conflict
# Esperado: 409, mesma mensagem do bloco 6.
POST {{baseUrl}}/requisicoes/{{criar.response.body.$.id}}/recusar
Content-Type: {{contentType}}

{
  "motivoRecusa": "tentando recusar uma requisição já ACEITA"
}

### 8. Id inexistente -> 404 Not Found
# Esperado: 404
# { "status": 404, "detail": "Requisição não encontrada", ... }
GET {{baseUrl}}/requisicoes/99999
Accept: {{contentType}}

### 9. Enum inválido -> 400 Bad Request
# Esperado: 400 + "detail": "Failed to read request".
# O Jackson não desserializa o enum e o corpo nunca vira um objeto —
# nenhuma linha do service roda. O valor válido é "PLASMA"; o nome
# longo abaixo não existe no enum, por isso serve de caso de erro.
POST {{baseUrl}}/requisicoes
Content-Type: {{contentType}}

{
  "hospitalId": 7,
  "tipo": "PLASMA_FRESCO_CONGELADO",
  "abo": "O",
  "rh": "NEGATIVO",
  "volumeMl": 450,
  "prioridade": "NORMAL"
}

### 10. volumeMl nulo -> 400 Bad Request
# Esperado: 400 "Failed to read request".
# `volumeMl` é double primitivo, não Double: o Jackson não mapeia null nele.
POST {{baseUrl}}/requisicoes
Content-Type: {{contentType}}

{
  "hospitalId": 7,
  "tipo": "HEMACIAS",
  "abo": "O",
  "rh": "NEGATIVO",
  "volumeMl": null,
  "prioridade": "NORMAL"
}

### 11. Campo obrigatório ausente -> 500 (deveria ser 400)
# Esperado HOJE: 500 Internal Server Error.
# Aqui o JSON FOI lido com sucesso — o problema é outro: falta `@Valid` no
# @RequestBody do controller, então o @NotNull de `tipo` só estoura no flush
# do Hibernate, tarde demais para virar 400.
POST {{baseUrl}}/requisicoes
Content-Type: {{contentType}}

{
  "hospitalId": 7,
  "abo": "O",
  "rh": "NEGATIVO",
  "volumeMl": 450,
  "prioridade": "NORMAL"
}


###############################################################################
# FLUXO DE RECUSA (precisa de uma requisição nova, ainda ABERTA)
###############################################################################

### 12. Criar uma segunda requisição para testar a recusa
# @name criarParaRecusa
POST {{baseUrl}}/requisicoes
Content-Type: {{contentType}}

{
  "hospitalId": 3,
  "tipo": "PLAQUETAS",
  "abo": "AB",
  "rh": "POSITIVO",
  "volumeMl": 250,
  "prioridade": "URGENCIA"
}

### 13. Recusar sem motivo -> 400 Bad Request
# Esperado: 400
# { "status": 400, "detail": "Motivo da recusa é obrigatório", ... }
# Repare que o detail é ESPECÍFICO, diferente do "Failed to read request"
# dos blocos 9 e 10: aqui o JSON foi lido e quem barrou foi o service.
# Nada é gravado — ele valida o motivo ANTES de mexer no status.
POST {{baseUrl}}/requisicoes/{{criarParaRecusa.response.body.$.id}}/recusar
Content-Type: {{contentType}}

{}

### 14. Recusar com motivo em branco -> 400 Bad Request
# Esperado: 400 — o service usa isBlank(), então só espaços também barra.
POST {{baseUrl}}/requisicoes/{{criarParaRecusa.response.body.$.id}}/recusar
Content-Type: {{contentType}}

{
  "motivoRecusa": "   "
}

### 15. Recusar com motivo válido  (ABERTA -> RECUSADA)
# Esperado: 200 + "status": "RECUSADA" e "motivoRecusa" preenchido.
POST {{baseUrl}}/requisicoes/{{criarParaRecusa.response.body.$.id}}/recusar
Content-Type: {{contentType}}

{
  "motivoRecusa": "Estoque de plaquetas AB+ insuficiente"
}


###############################################################################
# LIMPEZA
###############################################################################

### 16. Deletar a primeira requisição
# Esperado: 200 com corpo vazio (não 204).
# É hard delete — a linha some do banco.
DELETE {{baseUrl}}/requisicoes/{{criar.response.body.$.id}}

### 17. Deletar a segunda
DELETE {{baseUrl}}/requisicoes/{{criarParaRecusa.response.body.$.id}}

### 18. Confirmar que sumiu -> 404
GET {{baseUrl}}/requisicoes/{{criar.response.body.$.id}}


###############################################################################
# NÃO IMPLEMENTADO (desenho alvo — estas chamadas não funcionam hoje)
###############################################################################

### Filtro por status (HU05)
# Hoje: o parâmetro é ignorado, devolve tudo.
GET {{baseUrl}}/requisicoes?status=ABERTA

### Alocação de hemocomponentes (HU06)
# Hoje: 405 Method Not Allowed — a rota não existe.
POST {{baseUrl}}/requisicoes/1/alocacoes

### Cancelamento pelo hospital
# Hoje: 405 — CANCELADA existe no enum mas nenhuma rota chega nele.
POST {{baseUrl}}/requisicoes/1/cancelar
